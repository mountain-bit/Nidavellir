{
    "name": "silnikgierparagrafowych",
    "version": "1.0.0",
    "packageManager": "pnpm@9.15.5",
    "engines": {
        "node": ">=20 <22",
        "pnpm": ">=9 <10"
    },
    "main": "main.js",
    "scripts": {
        "start": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify && tsc --noEmit && node scripts/build-renderer.js && electron .",
        "build": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify && tsc --noEmit && node scripts/build-renderer.js",
        "renderer:watch": "node scripts/build-renderer.js --watch",
        "css:build": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify",
        "css:watch": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "license:check": "node scripts/check-licenses.js",
        "lint": "eslint \"**/*.{ts,js}\"",
        "lint:fix": "eslint \"**/*.{ts,js}\" --fix",
        "format": "prettier --write \"**/*.{ts,js}\"",
        "format:check": "prettier --check \"**/*.{ts,js}\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "Silnik do tworzenia gier paragrafowych",
    "dependencies": {
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-mention": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@tiptap/suggestion": "^3.31.4",
        "cytoscape": "^3.33.3",
        "i18next": "^26.3.6",
        "i18next-fs-backend": "^2.6.7",
        "tiptap-markdown": "^0.9.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "electron": "41.5.0",
        "esbuild": "^0.28.2",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "happy-dom": "^20.11.6",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.0",
        "vitest": "^1.0.0"
    }
}
