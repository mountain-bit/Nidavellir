{
    "name": "silnikgierparagrafowych",
    "version": "1.3.24",
    "packageManager": "pnpm@9.15.5",
    "engines": {
        "node": ">=20 <22",
        "pnpm": ">=9 <10"
    },
    "main": "main.js",
    "scripts": {
        "start": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify && node scripts/build-renderer.js && tsc --noEmit && electron .",
        "build": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify && node scripts/build-renderer.js && tsc --noEmit",
        "renderer:watch": "node scripts/build-renderer.js --watch",
        "css:build": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --minify",
        "css:watch": "tailwindcss -i ./View/MainWindow.css -o ./View/MainWindow.generated.css --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "license:check": "node scripts/check-licenses.js",
        "lint": "eslint \"**/*.{ts,js}\"",
        "lint:fix": "eslint \"**/*.{ts,js}\" --fix",
        "format": "prettier --write \"**/*.{ts,js}\"",
        "format:check": "prettier --check \"**/*.{ts,js}\"",
        "pack": "pnpm run build && electron-builder --dir",
        "dist": "pnpm run build && electron-builder --win",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "Nidavelir — zaawansowane środowisko do tworzenia gier paragrafowych",
    "dependencies": {
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-mention": "^3.31.4",
        "@tiptap/extension-underline": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@tiptap/suggestion": "^3.31.4",
        "adm-zip": "^0.6.1",
        "archiver": "^8.0.0",
        "cytoscape": "^3.33.3",
        "docx": "^9.11.0",
        "i18next": "^26.3.6",
        "i18next-fs-backend": "^2.6.7",
        "tiptap-markdown": "^0.9.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@types/archiver": "^8.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "electron": "41.5.0",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "happy-dom": "^20.11.6",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.0",
        "vitest": "^1.0.0"
    },
    "build": {
        "appId": "com.mountainbit.nidavelir",
        "productName": "Nidavelir",
        "directories": {
            "output": "release-builds"
        },
        "files": [
            "main.js",
            "preload.js",
            "main/**/*",
            "View/**/*",
            "Locales/**/*",
            "Utils/**/*",
            "dist/**/*",
            "package.json",
            "!**/tests/**",
            "!**/*.test.*",
            "!**/*.ts",
            "!**/*.map"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Nidavelir"
        }
    }
}